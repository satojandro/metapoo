# Public configuration for the hosted build. No secrets belong here.
#
# Vite inlines every VITE_* value into the bundle at build time, so this file IS
# the deployment configuration: the host needs no dashboard variables for it to work.
# Values are public account IDs and a public RPC URL — the same class of value as
# `.env.example`, which is why this file is committed while real `.env*` files are not.
#
# MAINNET launch estate, 2026-11-13: parent `meta-poo-stall.near`, deployed with the
# exact wasm that ran the testing round (board code hash 93V8Jh43…). The testing estate
# (`fcd66acf…`) is kept untouched for new features; this file points at the launch board.

# Paid board (schema 4), owner admin.meta-poo-stall.near.
VITE_CONTRACT_ID=board.meta-poo-stall.near

# TOILET token the board mints into. Its emitter is the board above.
VITE_TOILET_ID=toilet.meta-poo-stall.near

VITE_NEAR_NETWORK=mainnet

# FastNEAR mainnet answers browser reads with CORS in ~0.26 s. rpc.mainnet.near.org
# works but takes ~3.2 s and is documented as deprecating under load, so it is only
# the backup; dRPC answers in ~0.8 s.
VITE_NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
VITE_NEAR_READ_FALLBACK_URL=https://near.drpc.org

# The board launches at 64 × 64 and can only grow. Drawing it before `get_board`
# answers stops the wall rendering 128 × 128 and then shrinking.
VITE_BOARD_SIDE=64

VITE_SPONSORSHIP_ENABLED=false

# Acquisition integrations stay off; Privy is the exception and is enabled below.
VITE_PRIVY_ENABLED=true
# Intents funding: ON for owner testing only (2026-11-10). The route's native-NEAR delivery is
# still unproven, so TEST MODE is on and the panel says so above every control. Flip both to
# false (or fill INTENTS_NATIVE_EVIDENCE from three real deposits) before players see it.
VITE_INTENTS_FUNDING_ENABLED=true
VITE_INTENTS_TEST_MODE=true
# 0.25 NEAR: the drawing session's lifetime gas allowance, so a funded account can always add
# its key and paint a while. Not a spend — a floor the balance must clear.
VITE_ACQUISITION_PLAY_RESERVE_YOCTO=250000000000000000000000
VITE_RHEA_MPOO_SWAP_ENABLED=false

# --- Previous testnet round, kept for reference -------------------------------
# VITE_CONTRACT_ID=board5.metapoo-player1.testnet
# VITE_TOILET_ID=toilet3.metapoo-player1.testnet
# VITE_NEAR_NETWORK=testnet
# VITE_NEAR_RPC_URL=https://rpc.testnet.fastnear.com

# Privy (Meta Poo app, created 2026-11-10). Values are public; the app secret is
# server-only and lives in Bitwarden, never in this file or the bundle.
# Enabled 2026-11-10 for a live test of Google/email login against
# https://metapoo-testnet.vercel.app, which is allowlisted in the Privy dashboard
# along with http://localhost:5173. An app client scopes sessions to this environment:
# it sets the session duration and allowed origins per client. Created 2026-11-10 and
# stored in Bitwarden as VITE_PRIVY_APP_CLIENT_ID (public: it ships in the bundle).
# UNVERIFIED: whether Privy provisions a NEAR wallet for this app. If it does not,
# turn VITE_PRIVY_ENABLED back to false rather than leaving a dead login entry.
VITE_PRIVY_APP_ID=cmw9wgh0f00500gkxkxsjy2hg
VITE_PRIVY_APP_CLIENT_ID=client-WY6faHS1wBBx3gdhQ7TDFwwNF9pSYmNxUt3JwgyfFdHdJ
VITE_PRIVY_SIGN_PAGE_URL=/privy-sign.html
# Absolute origin for the share tags (og:url, og:image). The production build refuses to run without it.
VITE_SITE_URL=https://metapoo.xyz

# The launch board is the real board: the beta notice ("this board will be paused and its
# TOILET is worthless") is a lie on it, so it is off here and only here (config.ts keeps it
# on for every build that forgets the variable). The tester guide and report links still
# come from the dashboard, so they keep working.
VITE_BETA_BANNER=false
