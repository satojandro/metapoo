# Public configuration for the hosted build. No secrets belong here.
#
# Vite inlines every VITE_* value into the bundle at build time, so this file IS
# the deployment configuration: the host needs no dashboard variables for it to work.
# Values are public account IDs and a public RPC URL — the same class of value as
# `.env.example`, which is why this file is committed while real `.env*` files are not.
#
# MAINNET testing round, 2026-11-05. Both addresses are fresh implicit accounts
# created for this round, not existing contracts: `docs/payments/mainnet-deploy-runbook.md`
# lists what still has to be deployed onto them. Until that runs, the page reads an
# empty account. This is a testing release on mainnet, not the public launch.

# Paid board (schema 4). Fresh implicit account, `new()` still to be called.
VITE_CONTRACT_ID=fcd66acf517ad5d77f4814ad939b2b69b4ab2529e8332fbbeb3aaed63076f59e

# TOILET token the board mints into. Its emitter is the board above.
VITE_TOILET_ID=a571dead0abc8d307f6da72e38ae9c9006c87db9007b1e186eae14b2ee7801ee

VITE_NEAR_NETWORK=mainnet

# FastNEAR mainnet answers browser reads with CORS in ~0.26 s. rpc.mainnet.near.org
# works but takes ~3.2 s and is documented as deprecating under load, so it is only
# the backup; dRPC answers in ~0.8 s.
VITE_NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
VITE_NEAR_READ_FALLBACK_URL=https://near.drpc.org

# The board launches at 64 × 64 and can only grow. Drawing it before `get_board`
# answers stops the wall rendering 128 × 128 and then shrinking.
VITE_BOARD_SIDE=64

VITE_SPONSORSHIP_ENABLED=false

# Acquisition integrations stay off: fixture-tested only, and Privy needs a
# reviewed dependency patch before it is enabled on any public origin.
VITE_PRIVY_ENABLED=false
VITE_INTENTS_FUNDING_ENABLED=false
VITE_RHEA_MPOO_SWAP_ENABLED=false

# --- Previous testnet round, kept for reference -------------------------------
# VITE_CONTRACT_ID=board5.metapoo-player1.testnet
# VITE_TOILET_ID=toilet3.metapoo-player1.testnet
# VITE_NEAR_NETWORK=testnet
