# Copy to web/.env and restart `npm run dev`.
# Never commit a real .env with secrets. These values are public config only.

# Game board contract account on the chosen network.
# Leave empty to keep the page in local mock / read-only-without-chain mode.
# Do NOT use the MPOO token account here.
# Canonical paid board (schema 4) on testnet:
VITE_CONTRACT_ID=board3.metapoo-player1.testnet

# TOILET token the board mints into (its emitter must be the board above).
# Leave empty to hide TOILET balances and the claim button.
VITE_TOILET_ID=metapoo-toilet.testnet

# NEAR network for the wallet connector and explorer links.
# Allowed: mock | localnet | testnet | mainnet
# Default if unset: testnet
VITE_NEAR_NETWORK=testnet

# Board side to draw before get_board answers. Optional: the contract's reported
# size always wins. A fresh paid board is 64 (it can grow to 128 via expand_board);
# board3/board5 and the free board are 128, the default.
# VITE_BOARD_SIDE=64

# Public owner account, used by /admin only when get_owner is not deployed yet.
# The contract still enforces owner-only writes; this does not grant access.
# VITE_BOARD_OWNER=owner.testnet

# Optional JSON-RPC URL for view calls (get_board / get_pixel).
# Defaults:
#   testnet  -> https://rpc.testnet.near.org
#   mainnet  -> https://rpc.mainnet.near.org
#   localnet -> http://127.0.0.1:3030
# VITE_NEAR_RPC_URL=https://rpc.testnet.near.org

# Optional bearer token for that endpoint (FastNEAR and similar bill per request).
# This value is compiled into the public bundle: anyone can read it and spend our
# quota. On FastNEAR's free trial the domain-restricted "browser key" that fixes
# that is not available, so leave this empty for a deployed page and keep the key
# server-side (keeper, scripts) or behind a proxy. See docs/ops/fastnear-rpc.md.
# VITE_NEAR_RPC_API_KEY=

# Optional board server (ops/board-server, a port of Berry Fast), no trailing slash.
# Empty keeps today's behaviour exactly: the wall polls the chain and contacts no server.
# Set, the wall loads the board blob from it, takes live draws over its WebSocket
# ({url with http->ws}/ws), and pauses chain polling while the socket is open and the
# server keeps up (one get_board_version trust check a minute). Prices, credits,
# quotes and claims stay chain reads.
# VITE_BOARD_SERVER_URL=https://board.example.org

# Gas sponsorship feature flag. Keep false for MVP.
# Even if set true, the page falls back to the ordinary wallet path
# because no sponsor service is wired.
VITE_SPONSORSHIP_ENABLED=false

# Optional acquisition integrations. Players pay all gas; these do not enable token checkout.
VITE_PRIVY_ENABLED=false
VITE_PRIVY_APP_ID=
VITE_PRIVY_APP_CLIENT_ID=
# Exact public URL registered with Privy (same origin, include deployment base path).
VITE_PRIVY_SIGN_PAGE_URL=
VITE_INTENTS_FUNDING_ENABLED=false
VITE_INTENTS_API_BASE=https://1click.chaindefuser.com
VITE_INTENTS_TRANSPORT=direct
VITE_INTENTS_PROXY_BASE=
VITE_RHEA_MPOO_SWAP_ENABLED=false
# Set integer yoctoNEAR budgets at release after measuring the supported route.
VITE_ACQUISITION_PLAY_RESERVE_YOCTO=
VITE_RHEA_MAX_INPUT_YOCTO=
VITE_RHEA_GAS_RESERVE_YOCTO=
VITE_RHEA_MAX_PRICE_IMPACT_BPS=
# No API keys/secrets go here. Intents CORS/native-delivery and RHEA net-output
# evidence gates must pass independently of these flags.

# Backup for read-only RPC calls; must belong to VITE_NEAR_NETWORK.
# Defaults to rpc.testnet.near.org on testnet, rpc.mainnet.near.org on mainnet.
# Local/mock networks do not use a public fallback. Broadcasts never use it.
# VITE_NEAR_READ_FALLBACK_URL=https://rpc.testnet.near.org

# Beta-round notice at the top of every page: "this board and TOILET are for testing
# only". On unless set to exactly "false". Turn it off for the launch board only.
# VITE_BETA_BANNER=false
# Public links shown in the notice (published Notion pages). Empty hides each link.
VITE_BETA_GUIDE_URL=https://purple-father-699.notion.site/Meta-Poo-Beta-Tester-Guide-4102d0ca8ffc81bf8701cc22d37d4961
VITE_BETA_REPORT_URL=https://purple-father-699.notion.site/93b8b8a482f045d4a3bd0fd5c79db2ab
