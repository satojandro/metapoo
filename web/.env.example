# Copy to web/.env and restart `npm run dev`.
# Never commit a real .env with secrets. These values are public config only.

# Game board contract account on the chosen network.
# Leave empty to keep the page in local mock / read-only-without-chain mode.
# Do NOT use the MPOO token account here.
# Canonical paid board (schema 4) on testnet:
VITE_CONTRACT_ID=board3.metapoo-player1.testnet

# NEAR network for the wallet connector and explorer links.
# Allowed: mock | localnet | testnet | mainnet
# Default if unset: testnet
VITE_NEAR_NETWORK=testnet

# Public owner account, used by /admin only when get_owner is not deployed yet.
# The contract still enforces owner-only writes; this does not grant access.
# VITE_BOARD_OWNER=owner.testnet

# Optional JSON-RPC URL for view calls (get_board / get_pixel).
# Defaults:
#   testnet  -> https://rpc.testnet.near.org
#   mainnet  -> https://rpc.mainnet.near.org
#   localnet -> http://127.0.0.1:3030
# VITE_NEAR_RPC_URL=https://rpc.testnet.near.org

# Gas sponsorship feature flag. Keep false for MVP.
# Even if set true, the page falls back to the ordinary wallet path
# because no sponsor service is wired.
VITE_SPONSORSHIP_ENABLED=false

# Optional acquisition integrations. Players pay all gas; these do not enable token checkout.
VITE_PRIVY_ENABLED=false
VITE_PRIVY_APP_ID=
VITE_PRIVY_APP_CLIENT_ID=
# Exact public URL registered with Privy (same origin, include deployment base path).
VITE_PRIVY_SIGN_PAGE_URL=
VITE_INTENTS_FUNDING_ENABLED=false
VITE_INTENTS_API_BASE=https://1click.chaindefuser.com
VITE_INTENTS_TRANSPORT=direct
VITE_INTENTS_PROXY_BASE=
VITE_RHEA_MPOO_SWAP_ENABLED=false
# Set integer yoctoNEAR budgets at release after measuring the supported route.
VITE_ACQUISITION_PLAY_RESERVE_YOCTO=
VITE_RHEA_MAX_INPUT_YOCTO=
VITE_RHEA_GAS_RESERVE_YOCTO=
VITE_RHEA_MAX_PRICE_IMPACT_BPS=
# No API keys/secrets go here. Intents CORS/native-delivery and RHEA net-output
# evidence gates must pass independently of these flags.
