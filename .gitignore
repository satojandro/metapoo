/contracts/bounties/target
/contracts/prints/target
/shared/history/rust/target

# Frontend dependencies and build output.
/web/node_modules
/web/dist

# Local secrets. This project should not have any yet.
.env
.env.*
!.env.example
!web/.env.example
# Public, non-secret build config for the hosted testnet deployment (no keys).
!web/.env.production
*.key
*.pem

# Orchestrator runtime files (local only)
.orchestrator-worktree.json
orchestrator-init.log
/contracts/paid-board/target
/contracts/toilet/target
/contracts/toilet-staking/target
