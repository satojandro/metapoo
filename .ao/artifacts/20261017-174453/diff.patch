+/** Align camera output to the physical pixel grid without introducing a second transform. */
+export function deviceAlignedCamera(camera: Camera, devicePixelRatio: number): Camera {
+  const dpr =
+    Number.isFinite(devicePixelRatio) && devicePixelRatio > 0
+      ? devicePixelRatio
+      : 1;
+  // Quantizing the full board extent keeps its CSS size exactly representable
+  // by an integer canvas backing store. Pan is aligned independently.
+  const boardStep = 1 / (BOARD_WIDTH * dpr);
+  return {
+    cellSize: Math.round(camera.cellSize / boardStep) * boardStep,
+    panX: Math.round(camera.panX * dpr) / dpr,
+    panY: Math.round(camera.panY * dpr) / dpr,
+  };
+}
+
