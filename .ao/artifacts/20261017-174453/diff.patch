+export function logicalCellDeviceRect(
+  x: number,
+  y: number,
+  bitmapWidth: number,
+  bitmapHeight: number,
+): DevicePixelRect {
+  const left = Math.round((x * bitmapWidth) / BOARD_WIDTH);
+  const right = Math.round(((x + 1) * bitmapWidth) / BOARD_WIDTH);
+  const top = Math.round((y * bitmapHeight) / BOARD_HEIGHT);
+  const bottom = Math.round(((y + 1) * bitmapHeight) / BOARD_HEIGHT);
+  return { left, top, width: right - left, height: bottom - top };
+}
+
+/** Resize only when necessary because assigning width/height clears the bitmap. */
+export function resizeBoardBackingStore(
+  canvas: HTMLCanvasElement,
+  cssWidth: number,
+  cssHeight: number,
+  devicePixelRatio: number,
+): boolean {
+  const size = backingStoreSize(cssWidth, cssHeight, devicePixelRatio);
+  if (canvas.width === size.width && canvas.height === size.height) {
+    return false;
+  }
+  canvas.width = size.width;
+  canvas.height = size.height;
+  return true;
+}
