# Production host only (DEPLOY-HETZNER.md). Leave both unset for local or Mini use.
# The public hostname Caddy serves and gets a certificate for:
# BOARD_HOSTNAME=board.example.com
# Adds Caddy and the production Valkey settings to every `docker compose` command:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# The board. Mainnet testing board (docs/payments/mainnet-test-deployment-2026-11-05.md):
CONTRACT_ID=fcd66acf517ad5d77f4814ad939b2b69b4ab2529e8332fbbeb3aaed63076f59e
CHAIN_ID=mainnet
# First run only: the block that included the board's deploy tx ACQgeL1Y…VJLSB4hiyTne9a
# (looked up on archival-rpc.mainnet.fastnear.com, 7 Nov). After that the indexer resumes from Valkey.
START_BLOCK_HEIGHT=223113576
# The board's side at deploy (paid board LAUNCH_SIDE). board_expanded events grow it.
INITIAL_SIDE=64
# txindex (default): FastNEAR's transaction index, polled only while someone watches.
# stream: every final block from NEAR Data, ~6,200 requests/hour forever. Replays only.
INDEX_MODE=txindex
# txindex: poll interval while someone is watching (2 requests per poll). 30 s = 240/hour.
POLL_MS=30000
# txindex: optional key for the index. Unset = anonymous, nothing on your RPC dashboard.
# FASTNEAR_API_KEY=
# stream only: fetch parallelism and NEAR Data token (billed per block).
# NUM_THREADS=4
# AUTH_BEARER_TOKEN=
# WebSocket catch-up history. Berry Fast: 2 h. Spec B2 recommends 30 days (2592000000), undecided.
CATCHUP_RETENTION_MS=7200000
