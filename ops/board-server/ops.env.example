# Settings for scripts/backup-valkey.sh and scripts/health-alert.sh on the production box.
# Copy to ops.env (gitignored), chmod 600. Nothing here is read by the containers.

# --- alerts: where a problem is sent. Set at least one. ---------------------------------
# ntfy: free, no account. Pick a long random topic (it is the only secret), subscribe to it
# in the ntfy phone app.
# ALERT_NTFY_URL=https://ntfy.sh/<long-random-topic>
# Telegram: any bot's token (the alerts bot from AWAY-B will do) and your own chat id.
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# Anything else: a command that takes the message as its last argument.
# ALERT_CMD=
# Optional dead-man's switch, pinged on every healthy run (e.g. a free healthchecks.io check):
# ALERT_HEARTBEAT_URL=

# The public health URL, so a broken certificate, DNS or firewall is noticed too:
# ALERT_PUBLIC_URL=https://<board.example.com>/api/health

# Thresholds (defaults shown).
# ALERT_MEMORY_PCT=70         # Valkey used_memory as a share of maxmemory
# ALERT_DISK_PCT=80
# ALERT_QUEUE_MAX=500
# ALERT_BACKUP_MAX_AGE_H=36   # 0 = do not check backups
# ALERT_REMIND_HOURS=6

# --- backups ------------------------------------------------------------------------------
# BACKUP_DIR=/home/deploy/metapoo/ops/board-server/backups
# BACKUP_KEEP=14              # newest files kept on the box
# Off the box, one of:
# BACKUP_RCLONE_REMOTE=board-backups:<bucket>/valkey     # an rclone remote (S3, Hetzner Object Storage, B2)
# BACKUP_UPLOAD_CMD=          # a command that takes the file path as its last argument
